# =============================================================
# Contoh konfigurasi environment variable untuk QC App.
# Salin file ini menjadi ".env" lalu isi nilainya, ATAU isi langsung
# lewat UI aplikasi (halaman "Laporan Foto QC" -> Pengaturan) yang otomatis
# menulis ke file .env ini. ATAU, saat deploy (AWS/Streamlit Cloud/Docker),
# isi sebagai environment variable / secrets di platform — itu akan
# diprioritaskan dibanding file .env ini.
#
# JANGAN commit file ".env" yang sudah berisi kredensial asli ke Git (lihat .gitignore).
# =============================================================

# --- Google Sheets (Service Account) — untuk menulis baris data QC ---
# ID diambil dari URL spreadsheet: docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=
# Isi seluruh isi file credential .json dari Service Account (satu baris),
# ATAU isi dengan path absolut ke file .json tsb (mis. /etc/secrets/service_account.json)
# Cukup aktifkan "Google Sheets API" untuk service account ini.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Jembatan upload foto ke Google Drive (Google Apps Script) ---
# WAJIB diisi supaya foto bisa terupload — Service Account TIDAK punya kuota
# storage Drive sendiri, jadi upload foto dialihkan lewat Web App Apps Script
# yang jalan atas nama akun Google pribadi. Deploy apps_script/Code.gs
# terlebih dahulu (instruksi lengkap ada di dalam file tsb), lalu isi:
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# (Opsional) ID folder Google Drive (milik akun yang deploy Apps Script)
# tempat foto QC diupload, dari URL folder:
# drive.google.com/drive/folders/<GOOGLE_DRIVE_FOLDER_ID> — kosongkan kalau
# tidak masalah foto masuk ke root My Drive akun tsb.
GOOGLE_DRIVE_FOLDER_ID=
