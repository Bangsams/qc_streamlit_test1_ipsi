# =====================================================================
# TEMPLATE Streamlit Secrets — CARA BARU (direkomendasikan)
# =====================================================================
# Di Streamlit Cloud: buka dashboard app -> klik app-nya -> "⋮" -> "Settings"
# -> tab "Secrets" -> paste isi di bawah ini (ganti nilai contoh dengan
# punya Anda) -> "Save". App akan otomatis restart & memuat secrets baru.
#
# KENAPA CARA INI, bukan tempel 1 JSON utuh?
# Karena kalau seluruh isi file .json ditempel sebagai SATU STRING panjang,
# gampang sekali salah escape backslash pada bagian "private_key" (mis. saat
# copy-paste lewat notepad/chat/aplikasi lain yang otomatis meng-escape
# ulang), menyebabkan error:
#     Gagal: Gagal membaca kredensial Service Account: Unable to load PEM
#     file ... Invalid symbol 92, offset 0.
# (92 = kode ASCII karakter backslash \ — artinya ada backslash "nyasar" di
# tempat yang seharusnya baris baru).
#
# Dengan format TOML TABLE di bawah, "private_key" ditulis dengan BARIS BARU
# ASLI (persis seperti isi file .json aslinya kalau dibuka teks editor),
# BUKAN dengan kode "\n" — jadi tidak ada proses escape/unescape yang bisa
# salah sama sekali.
#
# CARA ISI:
# 1. Buka file .json Service Account Anda dengan text editor biasa
#    (Notepad/TextEdit/VS Code, dsb — JANGAN dibuka pakai Excel/Word).
# 2. Salin nilai tiap field (type, project_id, private_key_id, dst) ke
#    baris yang sesuai di bawah ini.
# 3. KHUSUS "private_key": salin APA ADANYA termasuk baris
#    "-----BEGIN PRIVATE KEY-----" dan "-----END PRIVATE KEY-----", dan
#    JANGAN diubah/dirapikan jadi satu baris. Biarkan tanda kutip tiga
#    (""") di baris atas & bawahnya seperti contoh ini.
# =====================================================================

# --- Key lain (flat) — WAJIB ditulis SEBELUM [gcp_service_account] di
# bawah, karena format TOML: semua baris SETELAH sebuah [table] otomatis
# ikut masuk ke table itu, bukan jadi key terpisah lagi. ---
GOOGLE_SHEET_ID = "1X9dMYm8dwQkVISoJwF1sCWOasKraomTczgRI0QjUyNs"
GOOGLE_DRIVE_FOLDER_ID = "1El6zq6D3x_NbBCs1hjHcn-VZVuq5qPJs"
GOOGLE_APPS_SCRIPT_URL = "https://script.google.com/macros/s/XXXXXXXX/exec"
GOOGLE_APPS_SCRIPT_SECRET = "token_rahasia_apps_script_anda"

[gcp_service_account]
type = "service_account"
project_id = "qc-app-streamlit-ipsi"
private_key_id = "ISI_DENGAN_PRIVATE_KEY_ID_ANDA"
private_key = """-----BEGIN PRIVATE KEY-----
MIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwggSiAgEAAoIBAQD...ISI_PERSIS_DARI_FILE_JSON_ANDA...
...................................................
...................................................
-----END PRIVATE KEY-----
"""
client_email = "ISI_DENGAN_CLIENT_EMAIL_ANDA@xxxxx.iam.gserviceaccount.com"
client_id = "ISI_DENGAN_CLIENT_ID_ANDA"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "ISI_DENGAN_CLIENT_X509_CERT_URL_ANDA"
universe_domain = "googleapis.com"
# ^ INI TABLE TERAKHIR DI FILE. Kalau mau menambah key flat lagi, taruh
# SEBELUM baris "[gcp_service_account]" di atas, jangan sesudahnya.

# =====================================================================
# ALTERNATIF (kalau tidak mau pakai table [gcp_service_account] di atas):
# isi field satu-satu dengan prefix GOOGLE_SA_ — private_key TETAP pakai
# format """...""" (baris baru asli), bukan "\n". Hapus tanda # di bawah
# untuk memakainya, taruh di ATAS baris [gcp_service_account] (dan
# kosongkan/hapus table [gcp_service_account] itu supaya tidak dobel).
# =====================================================================
# GOOGLE_SA_TYPE = "service_account"
# GOOGLE_SA_PROJECT_ID = "qc-app-streamlit-ipsi"
# GOOGLE_SA_PRIVATE_KEY_ID = "ISI_DENGAN_PRIVATE_KEY_ID_ANDA"
# GOOGLE_SA_PRIVATE_KEY = """-----BEGIN PRIVATE KEY-----
# MIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwggSiAgEAAoIBAQD...
# -----END PRIVATE KEY-----
# """
# GOOGLE_SA_CLIENT_EMAIL = "xxxx@xxxxx.iam.gserviceaccount.com"
# GOOGLE_SA_CLIENT_ID = "ISI_DENGAN_CLIENT_ID_ANDA"
# GOOGLE_SA_CLIENT_X509_CERT_URL = "ISI_DENGAN_CLIENT_X509_CERT_URL_ANDA"
